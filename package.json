{
  "name": "wp-seo-agent",
  "version": "0.1.0",
  "description": "Claude-powered SEO, performance, accessibility & AI-visibility optimization agent for WordPress. Drives key pages toward 100/100 Lighthouse with human approval before publishing.",
  "type": "module",
  "bin": {
    "wp-seo-agent": "src/cli.js"
  },
  "scripts": {
    "audit": "node src/cli.js audit",
    "audit:page": "node src/cli.js audit --page",
    "images": "node src/cli.js images",
    "report": "node src/cli.js report",
    "approve": "node src/cli.js approve",
    "apply": "node src/cli.js apply",
    "wp:check": "node src/cli.js wp:check",
    "start": "node src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chrome-launcher": "^1.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "lighthouse": "^12.2.1",
    "ora": "^8.1.0",
    "sharp": "^0.33.5"
  },
  "keywords": [
    "wordpress",
    "seo",
    "lighthouse",
    "accessibility",
    "wcag",
    "core-web-vitals",
    "webp",
    "ai-seo",
    "claude"
  ],
  "license": "MIT"
}
