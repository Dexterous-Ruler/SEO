# ============================================================================
# CORE PLATFORM — REQUIRED for the Sentinel backend. The server logs a clear
# SECURITY warning (and refuses to encrypt credentials in production) when
# SITE_SECRET_KEY is unset; Claude/Supabase calls throw when their keys are absent.
# ============================================================================

# Supabase project (Postgres + PostgREST + pgcrypto RPCs). REQUIRED.
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key — server-side ONLY, never ship to the browser. REQUIRED.
SUPABASE_SERVICE_ROLE=

# Passphrase that encrypts every stored site / GSC / Airtable credential at rest.
# REQUIRED in production — if unset the server falls back to an INSECURE built-in
# dev key and warns loudly. Use a long random string (e.g. `openssl rand -hex 32`).
SITE_SECRET_KEY=

# Anthropic API key — powers all AI generation (meta, titles, answer blocks,
# briefs, chat). REQUIRED; calls throw "ANTHROPIC_API_KEY not set" without it.
ANTHROPIC_API_KEY=
# Optional model override (defaults to a current Claude Sonnet).
CLAUDE_MODEL=

# Port the backend listens on (most PaaS hosts inject PORT automatically).
API_PORT=8787

# ── WordPress connection ───────────────────────────────────────────────
# Your site's base URL (no trailing slash)
WP_BASE_URL=https://example.com

# WordPress REST API auth via Application Password.
# Create one at: WP Admin → Users → Profile → Application Passwords
WP_USERNAME=your-admin-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: a staging URL to apply/test changes against before production.
# Leave blank to operate directly against WP_BASE_URL (NOT recommended).
WP_STAGING_URL=

# ── Audit settings ─────────────────────────────────────────────────────
# Lighthouse form factor: mobile | desktop | both
LH_FORM_FACTOR=both

# Chrome path override (optional; auto-detected if blank)
CHROME_PATH=

# ── Image optimization ─────────────────────────────────────────────────
# Target WebP quality (1-100) and whether to also emit AVIF
IMG_WEBP_QUALITY=80
IMG_EMIT_AVIF=false

# ── PageSpeed Insights (scale tier) ────────────────────────────────────
# Google PSI API key — 25,000 req/day free. Create in Google Cloud Console,
# enable "PageSpeed Insights API", then RESTRICT the key (an unrestricted
# leaked key once cost a developer $55k). Used by `psi` to audit 1,498 URLs.
PSI_KEY=

# ── DataForSEO (keyword/competitor data — pay-as-you-go, replaces SEMrush) ──
# LOGIN = your account email. PASSWORD = the API password shown at
# https://app.dataforseo.com/api-access  (NOT your dashboard login password).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Google Search Console — one-click "Connect with Google" (OAuth) ────────
# Optional. When set, the Search Console screen shows a "Connect with Google"
# button so users sign in with their own Google account (no service-account key).
# Setup: Google Cloud Console → APIs & Services → Credentials → Create OAuth
# client ID → "Web application". Add an Authorized redirect URI of
#   <your-origin>/gsc-oauth-callback     (e.g. http://localhost:8787/gsc-oauth-callback
#   for local, and https://your-deployed-host/gsc-oauth-callback for prod).
# Then enable the "Google Search Console API" (+ "Indexing API" for auto-index).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# In production set this to your public origin so the redirect URI is built
# correctly behind a proxy (omit locally — it's auto-derived from the request).
PUBLIC_BASE_URL=

# ── Automation ─────────────────────────────────────────────────────────
# The scheduler runs SAFE analysis/sync jobs hands-off (auto-index new URLs to
# Google, GSC index-health + ranking-drop + decay alerts, content-gap keywords →
# Airtable). It never writes to live pages — those stay in the Review Queue.
# Set to "false" to turn the scheduler off entirely.
AUTOMATION_ENABLED=true

# ── Safety ─────────────────────────────────────────────────────────────
# Master switch: when true, the agent will NEVER write to the live site
# without an explicit, separate `apply` command after human approval.
DRY_RUN=true

# ── Optional integrations & research ───────────────────────────────────
# Perplexity + Tavily power the research / trending-intel features (optional —
# those features degrade gracefully when unset).
PERPLEXITY_API_KEY=
TAVILY_API_KEY=

# ── Experience Monitor (RUM beacon) — INERT unless enabled ─────────────
# The privacy-gated real-user beacon stays fully off until RUM_ENABLED=true AND
# each site is compliance-signed-off + armed in the UI. RUM_SAMPLE is the default
# sample fraction (0–1; e.g. 0.05 = 5%).
RUM_ENABLED=false
RUM_SAMPLE=0.05

# ── Concurrency / limits (optional tuning; sensible defaults if unset) ──
ANTHROPIC_CONCURRENCY=
DATAFORSEO_CONCURRENCY=
HEAVY_CONCURRENCY=
HEAVY_MAX_QUEUE=
JOB_CONCURRENCY=
MAX_BODY_BYTES=
REQ_TIMEOUT_MS=
# Owner label used for activity-log rows when a caller supplies none.
DEFAULT_ACTIVITY_OWNER=system
